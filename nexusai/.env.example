# ── Application ────────────────────────────────────────────────────
SECRET_KEY=<generate-with-secrets.token_hex(32)>
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

# ── Database (Docker default) ──────────────────────────────────────
MONGODB_URI=mongodb://nexusai:secret@localhost:27018/?authSource=admin
MONGODB_DB_NAME=nexusai
USE_MONGO_MOCK=false
ALLOW_LOCAL_VECTOR_FALLBACK=true
ATLAS_VECTOR_SEARCH_INDEX=
# Use MONGODB_URI=mongodb://localhost:27017 only if your own local MongoDB has no auth.
# Atlas Vector Search requires MongoDB Atlas; local MongoDB uses fallback.

# ── Redis (Docker default) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / Object storage (Docker default) ───────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexusai-documents
MINIO_USE_SSL=false

# ── AI model settings ─────────────────────────────────────────────
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── OAuth (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Observability (optional) ──────────────────────────────────────
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexusai-dev

# ── Billing / Stripe (optional) ─────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
