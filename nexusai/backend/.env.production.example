# NexusAI backend production template
# Copy to backend/.env.production and fill in real values.

ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=<generate-with-secrets.token_hex(32)>
REFRESH_TOKEN_SECRET=<generate-with-secrets.token_hex(32)>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["https://app.nexusai.app"]
APP_BASE_URL=https://app.nexusai.app
SERVER_URL=https://api.nexusai.app

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=nexusai
USE_MONGO_MOCK=false
ALLOW_LOCAL_VECTOR_FALLBACK=false
ATLAS_VECTOR_SEARCH_INDEX=document_chunks_vector_index

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=rediss://:<token>@<region>.upstash.io:6380/0

# ── Storage ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
MINIO_BUCKET=nexusai-documents
MINIO_USE_SSL=true
STATIC_DIR=static
STATIC_MOUNT_PATH=/static
STATIC_UPLOAD_SUBDIR=uploads

# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia
LLM_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional alternatives if you switch providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── OAuth / observability / email ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nexusai.app/api/auth/google/callback
SENTRY_DSN=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=NexusAI <noreply@nexusai.app>
