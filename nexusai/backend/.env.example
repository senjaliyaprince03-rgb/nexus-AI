# NexusAI backend local development template
# Copy to backend/.env and use with either:
# - docker compose up -d mongodb
# - docker compose up -d
#
# Notes:
# - Use only one MONGODB_URI value.
# - Use MONGODB_URI=mongodb://localhost:27017 only if your MongoDB has no
#   username/password.
# - USE_MONGO_MOCK=false is for real local MongoDB.
# - USE_MONGO_MOCK=true is only for tests/offline mode.
# - Local Docker MongoDB does not provide Atlas Vector Search.
# - When ATLAS_VECTOR_SEARCH_INDEX is empty and ALLOW_LOCAL_VECTOR_FALLBACK=true,
#   NexusAI uses local cosine similarity over stored embeddings.
# - For production semantic retrieval, use MongoDB Atlas and set
#   ATLAS_VECTOR_SEARCH_INDEX to your Atlas Vector Search index name.
# - MongoDB Atlas Vector Search requires Atlas, not normal local MongoDB.
# - Docker exposes MongoDB on localhost:27018 to avoid conflicts with any
#   MongoDB already installed on Windows at localhost:27017.
# - Full Docker Compose overrides hostnames internally so backend containers use
#   `mongodb`, `redis`, and `minio` instead of `localhost`.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=<generate-with-secrets.token_hex(32)>
REFRESH_TOKEN_SECRET=<generate-with-secrets.token_hex(32)>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
APP_BASE_URL=http://localhost:3000
SERVER_URL=http://localhost:8000

# ── MongoDB (local Docker service exposed on localhost:27018) ────────────────
MONGODB_URI=mongodb://nexusai:secret@localhost:27018/?authSource=admin
MONGODB_DB_NAME=nexusai
USE_MONGO_MOCK=false
ALLOW_LOCAL_VECTOR_FALLBACK=true
ATLAS_VECTOR_SEARCH_INDEX=

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3-compatible storage ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexusai-documents
MINIO_USE_SSL=false
STATIC_DIR=static
STATIC_MOUNT_PATH=/static
STATIC_UPLOAD_SUBDIR=uploads

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=all-MiniLM-L6-v2
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional alternatives if you want to switch providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HUGGINGFACE_API_KEY=
GROQ_API_KEY=

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Integration Modules (optional) ────────────────────────────────────────────
INTEGRATION_MODE=hybrid
INTELLIGENCE_HUB_ENABLED=true
DEEP_RESEARCH_ENABLED=true
SEARCH_API_KEY=
YOUTUBE_API_KEY=

# ── Billing / Stripe (optional) ─────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
