# ══════════════════════════════════════════════════════════════════════════════
# NexusAI — production environment variables
# Copy to backend/.env on your production server.
# Never commit this file with real values.
# ══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=production

# ── Database (MongoDB Atlas recommended) ─────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/nexusai?retryWrites=true&w=majority
MONGODB_DB_NAME=nexusai
USE_MONGO_MOCK=false
ALLOW_LOCAL_VECTOR_FALLBACK=false
ATLAS_VECTOR_SEARCH_INDEX=document_chunks_vector_index

# ── Redis (Upstash recommended for serverless-friendly Redis) ─────────────────
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64-char-hex-string>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia
OPENAI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=deepseek-ai/deepseek-v4-pro
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ── Object Storage (Cloudflare R2 recommended — S3-compatible, free egress) ──
MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
MINIO_BUCKET=nexusai-documents
MINIO_USE_SSL=true

# ── Email (Resend recommended) ────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=NexusAI <noreply@nexusai.local>
APP_BASE_URL=https://app.nexusai.local

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nexusai.local/api/auth/google/callback

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexusai-production

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.nexusai.local"]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
