# ══════════════════════════════════════════════════════════════════════════════
# NexusAI Frontend — environment variables
# Copy to .env.local for local development.
# NEXT_PUBLIC_* vars are embedded in the browser bundle at build time.
# Never put secrets in NEXT_PUBLIC_* variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: FastAPI runs on 8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Next.js routes use this when running inside Docker Compose.
# Keep unset for normal host development.
INTERNAL_API_URL=http://localhost:8000

# Production: point to your deployed backend
# NEXT_PUBLIC_API_URL=https://api.nexusai.example.com

# ── Sentry (optional — frontend error tracking) ───────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── Feature flags (optional) ──────────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_AGENTS=true    # Show the Agents page in sidebar
# NEXT_PUBLIC_ENABLE_ANALYTICS=true # Show the Analytics page in sidebar
