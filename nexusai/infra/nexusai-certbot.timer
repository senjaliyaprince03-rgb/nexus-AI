# /etc/systemd/system/nexusai-certbot.timer
# Runs cert renewal twice daily (recommended by Let's Encrypt).
# Install:
#   sudo cp infra/nexusai-certbot.timer /etc/systemd/system/
#   sudo cp infra/nexusai-certbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nexusai-certbot.timer

[Unit]
Description=NexusAI — Let's Encrypt certificate renewal
Documentation=https://certbot.eff.org

[Timer]
# Run at 03:00 and 15:00 every day
OnCalendar=*-*-* 03,15:00:00
# Add random delay up to 1 hour to avoid hammering Let's Encrypt at :00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
