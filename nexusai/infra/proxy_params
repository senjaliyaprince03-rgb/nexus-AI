# Shared proxy headers — included by every location block via:
#   include /etc/nginx/proxy_params;
#
# Keeping these in one file ensures every upstream receives the same
# headers without copy-paste drift between location blocks.

# Use HTTP/1.1 for upstream connections.
# HTTP/1.0 (the default) doesn't support keepalive or chunked transfer,
# which breaks SSE streaming and is slower for everything else.
proxy_http_version 1.1;

# Clear the Connection header so nginx doesn't forward "keep-alive"
# from the client verbatim — that would prevent keepalive reuse with upstreams.
proxy_set_header Connection "";

# Forward the real client IP to FastAPI.
# FastAPI reads this in deps.py to enforce per-IP rate limits.
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

# Forward the original Host header — required by Next.js for SSR
# (it uses Host to determine the base URL for absolute redirects).
proxy_set_header Host $host;

# Pass the unique request ID — FastAPI logs it via structlog so a single
# request can be traced across nginx, FastAPI, and Celery logs.
proxy_set_header X-Request-ID $request_id;

# Standard upstream timeouts.
# connect: time to establish the TCP connection to the upstream.
# send:    time to transmit the full request to the upstream.
# read:    time to receive the first byte of the response.
# Overridden in SSE/WebSocket location blocks where responses are long-lived.
proxy_connect_timeout 10s;
proxy_send_timeout    30s;
proxy_read_timeout    30s;

# Enable response buffering (default) for regular requests.
# Overridden to "off" for SSE and WebSocket location blocks.
proxy_buffering on;
proxy_buffer_size        16k;
proxy_buffers            8 16k;
proxy_busy_buffers_size  32k;
