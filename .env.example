# ==========================================
# NEXUS MASTER PROJECT - UNIFIED CONFIG
# ==========================================

# ------------------------------------------
# 1. NexusAI Multi-Agent Intelligence Hub
# ------------------------------------------
GROQ_API_KEY=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_ID=

# ------------------------------------------
# 2. Nexus Agents (Deep Research System)
# ------------------------------------------
# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_AI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Search Providers
LINKUP_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# DB (Defaults are fine for local)
REDIS_URL=redis://localhost:6379
DUCKDB_PATH=./data/nexus.db
STORAGE_PATH=./data/storage

# ------------------------------------------
# 3. Nexus AI (GitHub - Sentiment & Chat)
# ------------------------------------------
# Uses OPENAI_API_KEY from above.

# ------------------------------------------
# 4. Nexus GCP (Cloud Run Microservices)
# ------------------------------------------
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# ------------------------------------------
# 5. PrimisAI Nexus
# ------------------------------------------
# Can reuse OPENAI_API_KEY from above.

# ------------------------------------------
# 6. Personal NexusAi Project
# ------------------------------------------
# Application
SECRET_KEY=<generate-with-secrets.token_hex(32)>
ENVIRONMENT=development

# Database (Docker Compose provides these)
# PostgreSQL: localhost:5433 (shifted to avoid conflicts)
# Redis: localhost:6380 (shifted to avoid conflicts)

# MinIO / Object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexusai-documents
MINIO_USE_SSL=false
MONGODB_URI=mongodb://nexusai:secret@localhost:27017/?authSource=admin
MONGODB_DB_NAME=nexusai
USE_MONGO_MOCK=true
ALLOW_LOCAL_VECTOR_FALLBACK=true

# AI Model Settings
LLM_PROVIDER=nvidia
LLM_MODEL=deepseek-ai/deepseek-v4-pro
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=all-MiniLM-L6-v2
NVIDIA_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# CORS Origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Billing / Stripe (optional) ─────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
